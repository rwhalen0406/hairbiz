# Copy this file to .env and fill in your values. Never commit .env.

# Square personal access token (Developer Dashboard -> your app -> Credentials).
# This app only ever performs READ requests against the Square API -- it never
# creates, updates, or deletes anything in your Square account.
SQUARE_ACCESS_TOKEN=

# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox

# Square API version header. Bump if you want a newer API version.
SQUARE_VERSION=2024-01-18

# Optional: restrict to one location. Leave blank to pull all locations on the account.
SQUARE_LOCATION_ID=

# How many days of order/payment/booking history to pull on each sync.
SYNC_LOOKBACK_DAYS=730

# Set to false if you don't use Square Appointments -- skips the Bookings API
# call entirely (avoids a "Merchant not onboarded to Appointments" warning).
# The report still works fully from Orders/Payments/Catalog data without it;
# you just lose the revenue-per-minute (chair-time) analysis.
SYNC_BOOKINGS=true

# Flask session secret -- set to any random string for production use.
FLASK_SECRET_KEY=dev-secret-change-me
