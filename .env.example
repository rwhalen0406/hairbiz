# Copy this file to .env and fill in your values. Never commit .env.

# Square personal access token (Developer Dashboard -> your app -> Credentials).
# This app only ever performs READ requests against the Square API -- it never
# creates, updates, or deletes anything in your Square account.
SQUARE_ACCESS_TOKEN=

# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox

# Square API version header. Bump if you want a newer API version.
SQUARE_VERSION=2024-01-18

# Optional: restrict to one location. Leave blank to pull all locations on the account.
SQUARE_LOCATION_ID=

# How many days of order/payment/booking history to pull on each sync.
SYNC_LOOKBACK_DAYS=365

# Set to false if you don't use Square Appointments -- skips the Bookings API
# call entirely (avoids a "Merchant not onboarded to Appointments" warning).
# The report still works fully from Orders/Payments/Catalog data without it;
# you just lose the revenue-per-minute (chair-time) analysis.
SYNC_BOOKINGS=true

# Comma-separated, case-insensitive substrings. Any sold line item whose name contains
# one of these is excluded from service performance/trend/bundling analysis -- use this
# to filter out retail product sales so the report focuses on styling services only.
# Leave blank to disable filtering.
EXCLUDED_ITEM_KEYWORDS=cream,hairspray,smoother,oil,shampoo

# Comma-separated, case-insensitive Square Items Library category names. Any sold item
# in one of these categories is excluded the same way as EXCLUDED_ITEM_KEYWORDS, but by
# category instead of name matching -- more reliable if your retail products are already
# grouped under a category like "Products" in Square. Leave blank to disable.
EXCLUDED_CATEGORIES=Products

# Flask session secret. Optional -- if left blank, a random one is generated on first
# run and stored in data/.flask_secret_key (gitignored), which is sufficient for local
# use. Set this explicitly only if you need session cookies to survive across
# reinstalls/multiple machines.
FLASK_SECRET_KEY=

# Network interface to bind to. 127.0.0.1 (default) only accepts connections from your
# own machine. Only change this to 0.0.0.0 if you specifically intend to expose the app
# to your network -- this app has no login of its own and holds a Square access token,
# so anyone who can reach it can view your business/client data and trigger a sync.
HOST=127.0.0.1

# Port to listen on.
PORT=5000

# Leave false. Flask's debug mode enables an interactive in-browser Python console on
# error pages -- if the app is ever reachable beyond your own machine (HOST=0.0.0.0),
# that console allows arbitrary code execution.
FLASK_DEBUG=false
